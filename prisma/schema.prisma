// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["mono"]
}

model User {
  id          String   @id @default(uuid()) @db.VarChar(36)
  outletId    String?  @db.VarChar(36)
  name        String   @db.VarChar(100)
  position    String   @db.VarChar(100)
  email       String   @db.VarChar(100)
  password    String   @db.VarChar(255)
  address     String   @db.VarChar(255)
  gender      String   @db.VarChar(10)
  phoneNumber String   @db.VarChar(20)
  fee         Float
  role        String   @default("EMPLOYEE") @db.VarChar(20)
  status      String   @default("active") @db.VarChar(50)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  outlet Outlet? @relation(fields: [outletId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  @@schema("mono")
}

model Message {
  id        String   @id @default(uuid()) @db.VarChar(36)
  outletId  String?
  message   String
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet Outlet? @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@schema("mono")
}

model Transaction {
  id                  String   @id @default(uuid()) @db.VarChar(36)
  userId              String?  @db.VarChar(36)
  outletId            String?  @db.VarChar(36)
  number              String   @db.VarChar(20)
  transactionType     String   @db.VarChar(50)
  tableNumber         Int?     @db.Integer
  paymentNumber       String   @db.VarChar(20)
  paymentMethod       String   @db.VarChar(50)
  customerName        String?  @db.VarChar(100)
  totalSubTransaction Int      @default(0) @db.Integer
  subTotal            Decimal  @default(0.0) @db.Decimal
  discount            Decimal  @default(0.0) @db.Decimal
  serviceCharge       Decimal  @default(0.0) @db.Decimal
  tax                 Decimal  @default(0.0) @db.Decimal
  rounding            Decimal  @default(0.0) @db.Decimal
  total               Decimal  @default(0.0) @db.Decimal
  additionalNote      String?  @db.VarChar(255)
  status              String   @default("pending") @db.VarChar(20)
  fraudStatus         String   @default("pending") @db.VarChar(20)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlet Outlet? @relation(fields: [outletId], references: [id], onDelete: Cascade)

  subTransactions SubTransaction[]

  @@schema("mono")
}

model SubTransaction {
  id            String   @id @default(uuid()) @db.VarChar(36)
  transactionId String   @db.VarChar(36)
  menuId        String   @db.VarChar(36)
  menuName      String   @db.VarChar(100)
  quantity      Int      @db.Integer
  price         Decimal  @db.Decimal
  subTotal      Decimal  @db.Decimal
  addOn         String   @db.VarChar(255)
  note          String   @db.VarChar(255)
  status        String   @default("preparation") @db.VarChar(20)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  menu        Menu        @relation(fields: [menuId], references: [id])
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@schema("mono")
}

model Outlet {
  id         String   @id @default(uuid()) @db.VarChar(36)
  outletType String   @db.VarChar(50)
  name       String   @db.VarChar(100)
  address    String?
  number     String?  @db.VarChar(20)
  province   String?  @db.VarChar(50)
  city       String?  @db.VarChar(50)
  postalCode String?  @db.VarChar(5)
  status     String   @default("active") @db.VarChar(20)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  transactions Transaction[]
  messages     Message[]
  users        User[]
  categories   Category[]
  menus        Menu[]

  @@schema("mono")
}

model Category {
  id        String   @id @default(uuid()) @db.VarChar(36)
  outletId  String?  @db.VarChar(36)
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menus  Menu[]
  outlet Outlet? @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@schema("mono")
}

model Menu {
  id         String   @id @default(uuid()) @db.VarChar(36)
  outletId   String?  @db.VarChar(36)
  name       String   @db.VarChar(100)
  desc       String
  img        String
  price      Decimal
  options    String[]
  pdf        String?  @db.VarChar(255)
  categoryId String   @db.VarChar(36)
  isNew      Boolean  @default(true)
  isBest     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  outlet         Outlet?          @relation(fields: [outletId], references: [id], onDelete: Cascade)
  category       Category         @relation(fields: [categoryId], references: [id])
  SubTransaction SubTransaction[]

  @@schema("mono")
}

model Option {
  id        String    @id @default(uuid()) @db.VarChar(36)
  name      String    @db.VarChar(100)
  value     String[]
  addPrices Decimal[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@schema("mono")
}
