// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid()) @db.VarChar(36)
  outletId    String?  @db.VarChar(36)
  name        String   @db.VarChar(100)
  position    String   @db.VarChar(100)
  email       String   @unique @db.VarChar(100)
  password    String   @db.VarChar(255)
  address     String   @db.VarChar(255)
  gender      String   @db.VarChar(10)
  phoneNumber String   @db.VarChar(20)
  role        String   @default("EMPLOYEE") @db.VarChar(20)
  status      String   @default("active") @db.VarChar(50)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  outlet            Outlet?            @relation(fields: [outletId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  stockTransactions StockTransaction[]
  cashBalances      CashBalance[]
  logCashBalances   LogCashBalance[]
  attendances       Attendance[]

  @@index([email])
  @@index([outletId])
  @@index([role])
  @@index([status])
  @@map("users")
}

model Message {
  id        String   @id @default(uuid()) @db.VarChar(36)
  outletId  String?  @db.VarChar(36)
  message   String
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet Outlet? @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([outletId])
  @@index([createdAt])
  @@map("messages")
}

model Transaction {
  id                  String   @id @default(uuid()) @db.VarChar(36)
  userId              String?  @db.VarChar(36)
  outletId            String?  @db.VarChar(36)
  number              String   @db.VarChar(20)
  transactionType     String   @db.VarChar(50)
  tableId             String?  @db.VarChar(36)
  paymentNumber       String   @db.VarChar(20)
  paymentMethod       String   @db.VarChar(50)
  customerName        String?  @db.VarChar(100)
  totalSubTransaction Int      @default(0) @db.Integer
  subTotal            Decimal  @default(0.0) @db.Decimal(15, 2)
  discount            Decimal  @default(0.0) @db.Decimal(15, 2)
  tax                 Decimal  @default(0.0) @db.Decimal(15, 2)
  serviceCharge       Decimal  @default(0.0) @db.Decimal(15, 2)
  rounding            Decimal  @default(0.0) @db.Decimal(15, 2)
  total               Decimal  @default(0.0) @db.Decimal(15, 2)
  additionalNote      String?  @db.VarChar(255)
  voucherId           String?  @db.VarChar(36)
  status              String   @default("pending") @db.VarChar(20)
  fraudStatus         String   @default("pending") @db.VarChar(20)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlet  Outlet?  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  table   Tables?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  voucher Voucher? @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  logVoucher      LogVoucher[]
  subTransactions SubTransaction[]
  logTableMove    LogTableMove[]
  discounts       Discount[]

  @@index([userId])
  @@index([outletId])
  @@index([tableId])
  @@index([status])
  @@index([createdAt])
  @@index([voucherId])
  @@index([outletId, status, createdAt])
  @@map("transactions")
}

model SubTransaction {
  id            String   @id @default(uuid()) @db.VarChar(36)
  transactionId String   @db.VarChar(36)
  menuId        String   @db.VarChar(36)
  menuName      String   @db.VarChar(100)
  quantity      Int      @db.Integer
  price         Decimal  @db.Decimal(15, 2)
  subTotal      Decimal  @db.Decimal(15, 2)
  addOn         String   @db.VarChar(255)
  addOnPrice    Decimal  @default(0) @db.Decimal(15, 2)
  discount      Decimal  @default(0) @db.Decimal(15, 2)
  note          String   @db.VarChar(255)
  status        String   @default("preparation") @db.VarChar(20)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  menu        Menu        @relation(fields: [menuId], references: [id])
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([menuId])
  @@index([status])
  @@index([transactionId, status])
  @@map("sub_transactions")
}

model Outlet {
  id         String   @id @default(uuid()) @db.VarChar(36)
  outletType String   @db.VarChar(50)
  name       String   @db.VarChar(100)
  address    String?
  number     String?  @db.VarChar(20)
  province   String?  @db.VarChar(50)
  city       String?  @db.VarChar(50)
  postalCode String?  @db.VarChar(5)
  status     String   @default("active") @db.VarChar(20)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  transactions      Transaction[]
  messages          Message[]
  users             User[]
  categories        Category[]
  menus             Menu[]
  vouchers          Voucher[]
  logVouchers       LogVoucher[]
  logTableMove      LogTableMove[]
  inventories       Inventory[]
  stockTransactions StockTransaction[]
  discounts         Discount[]
  tables            Tables[]
  cashBalances      CashBalance[]
  logCashBalances   LogCashBalance[]
  attendances       Attendance[]

  @@index([status])
  @@map("outlets")
}

model Category {
  id        String   @id @default(uuid()) @db.VarChar(36)
  outletId  String?  @db.VarChar(36)
  name      String   @db.VarChar(100)
  icon      String   @default("https://moeda-space.s3.ap-southeast-1.amazonaws.com/icon/default.png")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menus  Menu[]
  outlet Outlet? @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([outletId])
  @@map("categories")
}

model LogVoucher {
  id            String   @id @default(uuid()) @db.VarChar(36)
  outletId      String?  @db.VarChar(36)
  transactionId String   @db.VarChar(36)
  voucherId     String   @db.VarChar(36)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  outlet      Outlet?     @relation(fields: [outletId], references: [id], onDelete: Cascade)
  voucher     Voucher     @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([outletId])
  @@index([transactionId])
  @@index([voucherId])
  @@index([outletId, createdAt])
  @@map("log_vouchers")
}

model Discount {
  id          String   @id @default(uuid()) @db.VarChar(36)
  outletId    String   @db.VarChar(36)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  type        String   @default("percent") @db.VarChar(20)
  discount    Decimal  @default(0.0) @db.Decimal(15, 2)
  usage       Decimal  @default(0.0) @db.Decimal(10, 0)
  maxUsage    Decimal  @default(0.0) @db.Decimal(10, 0)
  allMenu     Boolean  @default(false)
  expiredAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  outlet       Outlet?       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  discountMenus DiscountMenu[]

  @@index([outletId])
  @@index([expiredAt])
  @@index([outletId, expiredAt])
  @@map("discounts")
}

model DiscountMenu {
  discountId String @db.VarChar(36)
  menuId     String @db.VarChar(36)

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  menu     Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([discountId, menuId])
  @@index([menuId])
  @@map("discount_menus")
}

model Voucher {
  id          String   @id @default(uuid()) @db.VarChar(36)
  outletId    String?  @db.VarChar(36)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  type        String   @default("percent") @db.VarChar(20)
  discount    Decimal  @default(0.0) @db.Decimal(15, 2)
  usage       Decimal  @default(0.0) @db.Decimal(10, 0)
  maxUsage    Decimal  @default(0.0) @db.Decimal(10, 0)
  allMenu     Boolean  @default(false)
  expiredAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  outlet       Outlet?       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  logVouchers  LogVoucher[]

  voucherMenus VoucherMenu[]

  @@index([outletId])
  @@index([expiredAt])
  @@index([outletId, expiredAt])
  @@map("vouchers")
}

model VoucherMenu {
  voucherId String @db.VarChar(36)
  menuId    String @db.VarChar(36)

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  menu    Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([voucherId, menuId])
  @@index([menuId])
  @@map("voucher_menus")
}

model Menu {
  id         String   @id @default(uuid()) @db.VarChar(36)
  outletId   String?  @db.VarChar(36)
  name       String   @db.VarChar(100)
  desc       String   @db.Text
  img        String   @default("https://moeda-space.s3.ap-southeast-1.amazonaws.com/default.png")
  price      Decimal  @db.Decimal(15, 2)
  pdf        String?  @db.VarChar(255)
  categoryId String   @db.VarChar(36)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  outlet         Outlet?          @relation(fields: [outletId], references: [id], onDelete: Cascade)
  category       Category         @relation(fields: [categoryId], references: [id])
  subTransaction SubTransaction[]

  voucherMenus    VoucherMenu[]
  discountMenus   DiscountMenu[]
  options         Option[]
  bestSellerMenus BestSellerMenu[]
  menuIngredients MenuIngredient[]

  @@index([outletId])
  @@index([categoryId])
  @@index([isActive])
  @@index([outletId, isActive])
  @@map("menus")
}

model Option {
  menuId String @id @db.VarChar(36)
  data   Json   @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  menu Menu @relation(fields: [menuId], references: [id])

  @@map("options")
}

model LogTableMove {
  id            String   @id @default(uuid()) @db.VarChar(36)
  outletId      String?  @db.VarChar(36)
  transactionId String   @db.VarChar(36)
  prevTableId   String?  @db.VarChar(36)
  nextTableId   String?  @db.VarChar(36)
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  outlet      Outlet?      @relation(fields: [outletId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  prevTable   Tables?      @relation("PrevTableMove", fields: [prevTableId], references: [id], onDelete: SetNull)
  nextTable   Tables?      @relation("NextTableMove", fields: [nextTableId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([outletId])
  @@index([prevTableId])
  @@index([nextTableId])
  @@index([outletId, createdAt])
  @@map("log_table_moves")
}

model BestSellerMenu {
  id        String   @id @default(uuid()) @db.VarChar(36)
  menuId    String   @unique @db.VarChar(36)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([order])
  @@map("best_seller_menus")
}

enum StockStatus {
  SAFE
  LOW
  OUT
}

enum StockTransactionType {
  ADD
  REDUCE
  ADJUST
}

model Inventory {
  id           String      @id @default(uuid()) @db.VarChar(36)
  outletId     String      @db.VarChar(36)
  name         String      @db.VarChar(100)
  unit         String      @db.VarChar(50)
  currentStock Decimal     @default(0) @db.Decimal(15, 3)
  minimumStock Decimal     @default(0) @db.Decimal(15, 3)
  status       StockStatus @default(SAFE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  outlet            Outlet             @relation(fields: [outletId], references: [id], onDelete: Cascade)
  stockTransactions StockTransaction[]
  menuIngredients   MenuIngredient[]

  @@index([outletId])
  @@index([name])
  @@index([status])
  @@index([outletId, status])
  @@map("inventories")
}

model StockTransaction {
  id           String               @id @default(uuid()) @db.VarChar(36)
  ingredientId String               @db.VarChar(36)
  outletId     String               @db.VarChar(36)
  type         StockTransactionType
  quantity     Decimal              @db.Decimal(15, 3)
  note         String?              @db.VarChar(255)
  createdAt    DateTime             @default(now())
  createdBy    String?              @db.VarChar(36)
  updatedAt    DateTime             @default(now()) @updatedAt

  inventory Inventory @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  outlet    Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [createdBy], references: [id])

  @@index([ingredientId])
  @@index([outletId])
  @@index([type])
  @@index([createdAt])
  @@index([ingredientId, createdAt])
  @@index([outletId, createdAt])
  @@map("stock_transactions")
}

model Tables {
  id        String   @id @default(uuid()) @db.VarChar(36)
  outletId  String   @db.VarChar(36)
  name      String   @db.VarChar(100)
  status    String   @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet         Outlet         @relation(fields: [outletId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  prevTableMoves LogTableMove[] @relation("PrevTableMove")
  nextTableMoves LogTableMove[] @relation("NextTableMove")

  @@index([outletId])
  @@index([name])
  @@index([status])
  @@index([outletId, status])
  @@map("tables")
}

model MenuIngredient {
  id           String   @id @default(uuid()) @db.VarChar(36)
  menuId       String   @db.VarChar(36)
  ingredientId String   @db.VarChar(36)
  quantity     Decimal  @db.Decimal(15, 3)
  unit         String   @db.VarChar(50)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  menu       Menu      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  ingredient Inventory @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([menuId, ingredientId])
  @@index([menuId])
  @@index([ingredientId])
  @@map("menu_ingredients")
}

model CashBalance {
  id        String   @id @default(uuid()) @db.VarChar(36)
  outletId  String   @db.VarChar(36)
  amount    Decimal  @db.Decimal(15, 2)
  status    String   @default("active") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet          Outlet?          @relation(fields: [outletId], references: [id], onDelete: Cascade)
  logCashBalances LogCashBalance[]
  user            User?            @relation(fields: [userId], references: [id])
  userId          String?          @db.VarChar(36)

  @@index([outletId])
  @@index([status])
  @@map("cash_balances")
}

model LogCashBalance {
  id             String   @id @default(uuid()) @db.VarChar(36)
  cashBalanceId  String   @db.VarChar(36)
  outletId       String   @db.VarChar(36)
  userId         String?  @db.VarChar(36)
  type           String   @db.VarChar(50)
  amount         Decimal  @db.Decimal(15, 2)
  previousAmount Decimal? @db.Decimal(15, 2)
  description    String?  @db.Text
  cancelNote     String?  @db.Text
  status         String   @default("active") @db.VarChar(20)
  createdAt      DateTime @default(now())

  cashBalance CashBalance @relation(fields: [cashBalanceId], references: [id], onDelete: Cascade)
  outlet      Outlet?     @relation(fields: [outletId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cashBalanceId])
  @@index([outletId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([outletId, createdAt])
  @@map("log_cash_balances")
}

model Attendance {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @db.VarChar(36)
  outletId  String   @db.VarChar(36)
  fileName  String   @db.VarChar(255)
  fileUrl   String   @db.Text
  note      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([outletId])
  @@index([createdAt])
  @@map("attendances")
}
